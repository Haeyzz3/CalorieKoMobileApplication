<?xml version="1.0" encoding="utf-8"?>
<!-- Compact notification layout for lock screen and collapsed state.
     This is a RemoteViews layout — only basic View types are allowed
     (TextView, ImageView, LinearLayout, etc). No ConstraintLayout or Compose. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Title -->
    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏃 Tracking Workout"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <!-- Row 2: Stats (time • distance • pace) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <!-- Timer -->
        <TextView
            android:id="@+id/notification_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  •  "
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Distance -->
        <TextView
            android:id="@+id/notification_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 km"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  •  "
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Pace -->
        <TextView
            android:id="@+id/notification_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-:-- /km"
            android:textColor="#333333"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
